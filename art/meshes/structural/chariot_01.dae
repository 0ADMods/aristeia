            <bind_material>
              <technique_common>
                <instance_material symbol="chariot_pers_b-material" target="#chariot_pers_b-material">
                  <bind_vertex_input semantic="chariotb-mesh-mesh-map-0" input_semantic="TEXCOORD" input_set="0"/>
                </instance_material>
              </technique_common>
            </bind_material>
          </instance_controller>
        </node>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>